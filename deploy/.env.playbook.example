# Playbook Media deployment (stage "playbook") -> https://seo.playbookmedia.io
# Copy to .env.playbook for a local deploy, or paste the filled-in contents into
# the ENV_PLAYBOOK repository secret for CI. Never commit the filled-in file.

# Hostname served by the app worker. The playbookmedia.io zone must live in the
# Cloudflare account used for the deploy. The workers.dev URL is disabled.
CUSTOM_DOMAIN=seo.playbookmedia.io

# This stage runs on its own D1 database (open-seo-db-playbook).
DATABASE_PROVIDER=d1

# cloudflare_access: only the listed emails can reach the app (recommended).
# hosted: public email/password signup. Requires Google OAuth, Loops and
# Turnstile configuration, and opens signup to anyone.
AUTH_MODE=cloudflare_access
ACCESS_ALLOWED_EMAILS=

# Stable, high-entropy, at least 32 characters. Encrypts stored GitHub
# publishing tokens and auth sessions. Rotating it requires reconnecting GitHub.
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Required by the deploy stack. Opportunities, publishing and experiments do not
# spend DataForSEO credits; keyword, domain and backlink research do.
DATAFORSEO_API_KEY=

# Google Search Console / GA4 OAuth client (docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md).
# Authorized redirect URIs: https://seo.playbookmedia.io/api/gsc/oauth/callback
# and https://seo.playbookmedia.io/api/ga4/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=
OPENSEO_TELEMETRY_DISABLED=true
