{
  "name": "open-seo",
  "private": true,
  "sideEffects": false,
  "version": "0.1.18",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "postinstall": "[ ! -f source.config.ts ] || fumadocs-mdx",
    "predev": "pnpm build:report-widgets",
    "dev": "vite dev",
    "predev:agents": "pnpm build:report-widgets",
    "dev:agents": "mkdir -p .logs && portless run vite dev 2>&1 | tee .logs/dev-server.log",
    "dev:everyapp": "everyapp dev",
    "dev:agents:force": "mkdir -p .logs && portless --force run vite dev 2>&1 | tee .logs/dev-server.log",
    "build": "pnpm build:report-widgets && vite build && tsc --noEmit",
    "build:standalone": "pnpm build:report-widgets && vite build --mode standalone && node scripts/celld/package.mjs",
    "build:report-widgets": "tsc --noEmit -p tsconfig.report-widgets.json && vite build -c vite.report-widgets.config.ts",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --type-aware --fix",
    "preview": "npm run build && vite preview --port 3001",
    "deploy": "npm run db:migrate:prod && npm run build && wrangler deploy -c dist/open_seo_audit/wrangler.json && wrangler deploy",
    "deploy:selfhost": "node scripts/selfhost-deploy-preflight.mjs && pnpm build:report-widgets && vite build --mode selfhost && tsc --noEmit && pnpm alchemy deploy deploy/alchemy/alchemy.run.ts --env-file .env.selfhost --stage selfhost",
    "deploy:prod": "pnpm deploy:postgres",
    "deploy:preview": "pnpm build:report-widgets && vite build --mode preview && pnpm alchemy deploy deploy/alchemy/alchemy.run.ts --env-file .env.preview",
    "preview:access": "pnpm alchemy deploy deploy/alchemy/alchemy.preview-access.run.ts --env-file .env.preview --stage preview-access --adopt",
    "alchemy": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-strip-types\" alchemy",
    "destroy:preview": "pnpm alchemy destroy deploy/alchemy/alchemy.run.ts --env-file .env.preview",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --config wrangler.jsonc --config wrangler.audit.jsonc",
    "types:check": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "auth:generate": "npm run auth:generate:d1 && npm run auth:generate:pg",
    "auth:generate:d1": "pnpm dlx auth@latest generate --config ./scripts/cli-auth.ts --adapter drizzle --dialect sqlite --output ./src/db/better-auth-schema.ts && prettier --write ./src/db/better-auth-schema.ts",
    "auth:generate:pg": "pnpm dlx auth@latest generate --config ./scripts/cli-auth.ts --adapter drizzle --dialect pg --output ./src/db/pg/better-auth-schema.ts && prettier --write ./src/db/pg/better-auth-schema.ts",
    "db:generate": "npm run db:generate:d1 && npm run db:generate:pg",
    "db:generate:d1": "drizzle-kit generate --config drizzle/sqlite.config.ts",
    "db:generate:pg": "drizzle-kit generate --config drizzle/pg.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "db:migrate:pg": "drizzle-kit migrate --config drizzle/pg.config.ts",
    "knip": "knip",
    "release:notes": "node scripts/release-notes.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "sync-plugin-skills": "node scripts/sync-plugin-skills.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "test:standalone:gateway": "node --test scripts/celld/runtime/crawl-gateway.test.mjs",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:core": "playwright test -c tests/playwright.core.config.ts",
    "test:e2e:free-tools": "playwright test -c tests/playwright.free-tools.config.ts",
    "test:e2e:mcp-isolation": "playwright test -c tests/playwright.mcp-isolation.config.ts",
    "test:e2e:domain": "playwright test -c tests/playwright.config.ts tests/domain-overview-filters.spec.ts",
    "test:e2e:domain:perf": "playwright test -c tests/playwright.config.ts tests/domain-overview-filters.perf.spec.ts",
    "test:e2e:keywords": "playwright test -c tests/playwright.config.ts tests/keyword-research-navigation.spec.ts",
    "billing:backlinks": "tsx scripts/backlinks-cost-profile.ts",
    "billing:brand-lookup": "tsx scripts/brand-lookup-cost-profile.ts",
    "billing:usage": "tsx scripts/dataforseo-account-usage.ts",
    "cleanup:default-projects:d1": "tsx scripts/d1-default-project-cleanup.ts",
    "gdpr:erase-user": "tsx scripts/erase-user-data.ts",
    "repair:rank-locations": "tsx scripts/repair-rank-tracking-locations.ts",
    "seed:rank-tracking": "tsx scripts/seed-rank-tracking.ts",
    "seed:projects": "tsx scripts/seed-projects.ts",
    "seed:marketing": "tsx scripts/seed-marketing.ts",
    "capture:product": "tsx scripts/capture-product-video.ts",
    "deploy:postgres": "npm run db:migrate:pg && pnpm build && pnpm alchemy deploy deploy/alchemy/alchemy.run.ts --env-file .env.production --stage hosted-prod --adopt",
    "standalone:admin": "docker compose -f deploy/standalone/compose.yaml exec -T runtime node /opt/standalone/admin.mjs",
    "selfhost:admin": "node --env-file=.env.selfhost scripts/celld/runtime/admin.mjs",
    "ci:check": "prettier --check . && knip && tsc --noEmit && tsc --noEmit -p tests/badseo/tsconfig.json && tsc --noEmit -p tsconfig.report-widgets.json && oxlint . --type-aware && pnpm sync-plugin-skills && test -z \"$(git status --porcelain -- plugins/openseo/skills)\"",
    "security:install": "bash security/install.sh",
    "security:scan": "bash security/scan.sh fast",
    "security:full": "bash security/scan.sh full",
    "security:dast": "bash security/scan.sh dast"
  },
  "cloudflare": {
    "bindings": {
      "AUTH_MODE": {
        "description": "Set to `cloudflare_access` for secured deployments behind Cloudflare Access, or `local_noauth` for trusted local self-host mode only."
      },
      "TEAM_DOMAIN": {
        "description": "Cloudflare Access team domain (for example `https://your-team.cloudflareaccess.com`) used to validate `cf-access-jwt-assertion` JWTs."
      },
      "POLICY_AUD": {
        "description": "Cloudflare Access Application Audience (AUD) tag for this Worker route/domain."
      },
      "DATAFORSEO_API_KEY": {
        "description": "Base64-encoded `login:password` for DataForSEO API access."
      },
      "OAUTH_KV": {
        "description": "KV namespace used by the Cloudflare Workers OAuth provider for MCP client registrations, grants, and tokens."
      }
    }
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.211",
    "@babel/parser": "7.29.9",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "1.7.11",
    "@cloudflare/think": "0.17.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@every-app/sdk": "0.3.0-rc.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/server": "2.3.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/query-core": "^5.103.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.21.3",
    "@trigger.dev/sdk": "4.6.4",
    "agents": "0.22.0",
    "ai": "^6.0.199",
    "autumn-js": "^1.3.26",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "^5.2.0",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.4.1",
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^13.0.8",
    "fumadocs-ui": "^16.16.2",
    "github-slugger": "2.0.0",
    "htmlparser2": "^10.1.0",
    "http-message-sig": "0.3.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "papaparse": "^5.5.3",
    "postgres": "^3.4.9",
    "posthog-js": "^1.395.0",
    "posthog-node": "^5.38.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "re2js": "^1.3.3",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remeda": "^2.33.6",
    "robots-parser": "^3.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.1.16",
    "takumi-js": "2.13.7",
    "tldts": "^7.0.25",
    "tw-animate-css": "^1.4.0",
    "web-bot-auth": "0.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vite-plugin-cf": "npm:@cloudflare/vite-plugin@2.0.0-beta.sha-91c870c02",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@distilled.cloud/cloudflare": "0.28.2",
    "@effect/platform-node": "4.0.0-beta.93",
    "@libsql/client": "^0.15.15",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@types/mdast": "4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.18.13",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.61",
    "atmn": "^2.0.79",
    "axe-core": "4.13.0",
    "chalk": "^5.6.2",
    "cf": "1.0.0-beta.14",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-beta.93",
    "everyapp": "0.3.0-rc.7",
    "knip": "^5.88.1",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "portless": "^0.5.2",
    "prettier": "^3.6.2",
    "shadcn": "^4.22.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
